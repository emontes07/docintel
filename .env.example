# Visionary Lab API - Environment Variables
# Authentication: Uses Azure Managed Identity (DefaultAzureCredential)
# For local development, run `az login` before starting the app.

# AI Foundry endpoint (unified for all AI services)
# This is the endpoint of your Azure AI Foundry resource.
# Find it in Azure Portal > AI Foundry resource > Overview > Endpoint
# ----------------------------------------------------------------------
AI_FOUNDRY_ENDPOINT=https://your-foundry-name.cognitiveservices.azure.com/

# Text-only Azure OpenAI endpoint advertised by the resource; do not derive it
# from the shared endpoint. Set in the repository-root .env or export locally.
# Process values override .env values. LLMClient prefers LLM_ENDPOINT and falls
# back to AI_FOUNDRY_ENDPOINT when unset/empty; other clients are not redirected.
LLM_ENDPOINT=https://your-foundry-name.openai.azure.com/

# Model deployment names
# These must match the deployment names created in your AI Foundry resource.
# ----------------------------------------------------------------------
LLM_DEPLOYMENT=gpt-4o

# Azure Cosmos DB for metadata storage (managed identity — no keys)
# ----------------------------------------------------------------------
AZURE_COSMOS_DB_ENDPOINT=https://<name_of_cosmos_account>.documents.azure.com:443/
AZURE_COSMOS_DB_ID=visionarylab
AZURE_COSMOS_CONTAINER_ID=metadata

# Azure Blob Storage for asset storage (managed identity — no keys)
# ----------------------------------------------------------------------
AZURE_BLOB_SERVICE_URL=https://<name_of_storage_account>.blob.core.windows.net/
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_BLOB_IMAGE_CONTAINER=images
AZURE_BLOB_VIDEO_CONTAINER=videos

# Azure Front Door (optional)
# ----------------------------------------------------------------------
# AZURE_FRONT_DOOR_ENDPOINT=https://your-frontdoor.azurefd.net
# AZURE_FRONT_DOOR_ENABLED=false

DOCINTEL_BATCH_MODE=hosted
DOCINTEL_BATCH_STORAGE_URL=https://storage.example.invalid
DOCINTEL_BATCH_CONTAINER=docintel-batches
DOCINTEL_BATCH_LIVE_ENABLED=false
DOCINTEL_AUTH_TENANT_ID=
DOCINTEL_AUTH_AUDIENCE=
DOCINTEL_AUTH_CLIENT_ID=
